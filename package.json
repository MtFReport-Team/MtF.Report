{
  "name": "mtf-report",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "dev": "pnpm run build:theme && pnpm --filter @mtfreport/docs dev",
    "build": "pnpm run build:theme && pnpm run build:docs",
    "build:theme": "pnpm --filter @project-trans/vitepress-theme-project-trans build",
    "build:docs": "pnpm --filter @mtfreport/docs build",
    "preview": "pnpm --filter @mtfreport/docs preview",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @project-trans/vitepress-theme-project-trans typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.17.0",
    "@unocss/eslint-plugin": "^66.3.3",
    "eslint": "^9.31.0",
    "eslint-plugin-format": "^1.0.1",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "is-core-module": "npm:@nolyfill/is-core-module@^1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
