{
  "name": "@project-trans/vitepress-theme-project-trans",
  "type": "module",
  "version": "0.8.0",
  "description": "A VitePress theme made with ❤️ by project-trans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-trans/vitepress-theme-project-trans"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    }
  },
  "main": "./dist/config.js",
  "module": "./dist/config.mjs",
  "types": "./dist/config.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@iconify-json/carbon": "^1.2.7",
    "@iconify-json/icon-park-outline": "^1.2.2",
    "@iconify-json/octicon": "^1.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vueuse/core": "^12.7.0",
    "unocss": "^66.0.0",
    "vite": "^5.4.0",
    "vitepress": "^1.6.3",
    "vitepress-sidebar": "^1.31.0",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.0",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.0",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.0",
    "@nolebase/vitepress-plugin-meta": "^2.18.0",
    "@project-trans/suggestion-box": "^0.5.2",
    "@vercel/analytics": "^1.5.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-pangu": "^1.0.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.16.4",
    "typescript": "^5.8.3",
    "unbuild": "3.3.1",
    "unplugin-vue-components": "^28.8.0",
    "vue-tsc": "^2.2.12"
  }
}
